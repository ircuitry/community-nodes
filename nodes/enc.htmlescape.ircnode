{
  "typeId": "enc.htmlescape",
  "title": "HTML Escape/Unescape",
  "subtitle": "community",
  "icon": "🌐",
  "category": "Data",
  "description": "Escapes or unescapes HTML entities in text.",
  "inputs": [
    {
      "name": "",
      "kind": "Exec"
    },
    {
      "name": "text",
      "kind": "Text"
    }
  ],
  "outputs": [
    {
      "name": "then",
      "kind": "Exec"
    },
    {
      "name": "result",
      "kind": "Text"
    }
  ],
  "params": [
    {
      "key": "mode",
      "label": "Mode",
      "type": "Choice",
      "default": "escape",
      "choices": ["escape", "unescape"]
    }
  ],
  "language": "python",
  "timeout": 8,
  "code": "import os, html\ntext = os.environ.get('TEXT') or os.environ.get('INPUT') or os.environ.get('MESSAGE') or ''\nmode = (os.environ.get('MODE') or 'escape').strip().lower()\ntry:\n    if mode == 'unescape':\n        result = html.unescape(text)\n    else:\n        result = html.escape(text)\n    print(result)\nexcept Exception as e:\n    print(f'error: {e}')\n"
}
