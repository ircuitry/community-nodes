{
  "typeId": "parse.hashtags",
  "title": "Extract Hashtags & Mentions",
  "subtitle": "community",
  "icon": "#️⃣",
  "category": "Filter",
  "description": "Extracts #hashtags and @mentions from text.",
  "inputs": [
    {
      "name": "",
      "kind": "Exec"
    },
    {
      "name": "text",
      "kind": "Text"
    }
  ],
  "outputs": [
    {
      "name": "then",
      "kind": "Exec"
    },
    {
      "name": "hashtags",
      "kind": "Text"
    },
    {
      "name": "mentions",
      "kind": "Text"
    }
  ],
  "params": [],
  "language": "python",
  "timeout": 8,
  "code": "import os, re, json\ntry:\n    text = os.environ.get('TEXT') or os.environ.get('INPUT') or os.environ.get('MESSAGE') or os.environ.get('ARGS') or ''\n    hashtags = re.findall(r'#\\w+', text)\n    mentions = re.findall(r'@\\w+', text)\n    print(json.dumps({'hashtags': ' '.join(hashtags), 'mentions': ' '.join(mentions)}))\nexcept Exception as e:\n    print(json.dumps({'hashtags': '', 'mentions': ''}))\n"
}
