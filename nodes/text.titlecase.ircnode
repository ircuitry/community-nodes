  "params": [],
  "language": "python",
  "timeout": 8,
  "code": "import os, re\nsrc = os.environ.get('TEXT') or os.environ.get('INPUT') or os.environ.get('ARGS') or os.environ.get('MESSAGE') or ''\ntry:\n    stop = {'a','an','the','and','or','but','of','in','on','to','for'}\n    words = re.split(r'(\\s+)', src.strip())\n    tokens = [i for i, w in enumerate(words) if w.strip()]\n    first = tokens[0] if tokens else -1\n    last = tokens[-1] if tokens else -1\n    out = []\n    for i, w in enumerate(words):\n        if not w.strip():\n            out.append(w)\n            continue\n        lw = w.lower()\n        if lw in stop and i != first and i != last:\n            out.append(lw)\n        else:\n            out.append(w[0].upper() + w[1:].lower())\n    print(''.join(out))\nexcept Exception as e:\n    print(src)\n"
}
