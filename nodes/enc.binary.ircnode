{
  "typeId": "enc.binary",
  "title": "Binary Encode/Decode",
  "subtitle": "community",
  "icon": "💾",
  "category": "Data",
  "description": "Converts text to or from a space-separated 8-bit binary string.",
  "inputs": [
    {
      "name": "",
      "kind": "Exec"
    },
    {
      "name": "text",
      "kind": "Text"
    }
  ],
  "outputs": [
    {
      "name": "then",
      "kind": "Exec"
    },
    {
      "name": "result",
      "kind": "Text"
    }
  ],
  "params": [
    {
      "key": "mode",
      "label": "Mode",
      "type": "Choice",
      "default": "encode",
      "choices": [
        "encode",
        "decode"
      ]
    }
  ],
  "language": "python",
  "timeout": 8,
  "code": "import os\ntext = os.environ.get('TEXT') or os.environ.get('INPUT') or os.environ.get('MESSAGE') or os.environ.get('ARGS') or ''\nmode = (os.environ.get('MODE') or 'encode').strip().lower()\ntry:\n    if mode == 'decode':\n        groups = text.split()\n        chars = [chr(int(g, 2)) for g in groups if g]\n        print(''.join(chars))\n    else:\n        print(' '.join(format(ord(c), '08b') for c in text))\nexcept Exception as e:\n    print(f'error: {e}')\n"
}
