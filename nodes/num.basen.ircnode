{
  "typeId": "num.basen",
  "title": "Number Base Converter",
  "subtitle": "community",
  "icon": "🔢",
  "category": "Data",
  "description": "Converts a number between arbitrary bases from 2 to 36.",
  "inputs": [
    {
      "name": "",
      "kind": "Exec"
    },
    {
      "name": "value",
      "kind": "Text"
    }
  ],
  "outputs": [
    {
      "name": "then",
      "kind": "Exec"
    },
    {
      "name": "result",
      "kind": "Text"
    }
  ],
  "params": [
    {
      "key": "from_base",
      "label": "From base",
      "type": "Int",
      "default": 10
    },
    {
      "key": "to_base",
      "label": "To base",
      "type": "Int",
      "default": 2
    }
  ],
  "language": "python",
  "timeout": 8,
  "code": "import os\n\ndef out(msg):\n    print(msg)\n\nvalue = (os.environ.get('VALUE') or os.environ.get('INPUT') or os.environ.get('ARGS') or '').strip()\n\ntry:\n    from_base = int(os.environ.get('FROM_BASE') or '10')\nexcept Exception:\n    from_base = 10\ntry:\n    to_base = int(os.environ.get('TO_BASE') or '2')\nexcept Exception:\n    to_base = 2\n\nif not value:\n    out('give a number to convert')\nelif not (2 <= from_base <= 36) or not (2 <= to_base <= 36):\n    out('bases must be between 2 and 36')\nelse:\n    try:\n        n = int(value, from_base)\n    except Exception:\n        out('invalid digit for base ' + str(from_base) + ': ' + value)\n    else:\n        digits = '0123456789abcdefghijklmnopqrstuvwxyz'\n        neg = n < 0\n        m = abs(n)\n        if m == 0:\n            res = '0'\n        else:\n            buf = []\n            while m > 0:\n                buf.append(digits[m % to_base])\n                m //= to_base\n            res = ''.join(reversed(buf))\n        if neg:\n            res = '-' + res\n        out(res)\n"
}
