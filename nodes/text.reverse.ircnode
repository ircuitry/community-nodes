{
  "typeId": "text.reverse",
  "title": "Reverse Text",
  "subtitle": "community",
  "icon": "🔁",
  "category": "Data",
  "description": "Reverses a string by characters, words, or lines.",
  "inputs": [
    {
      "name": "",
      "kind": "Exec"
    },
    {
      "name": "text",
      "kind": "Text"
    }
  ],
  "outputs": [
    {
      "name": "then",
      "kind": "Exec"
    },
    {
      "name": "result",
      "kind": "Text"
    }
  ],
  "params": [
    {
      "key": "mode",
      "label": "Mode",
      "type": "Choice",
      "default": "chars",
      "choices": [
        "chars",
        "words",
        "lines"
      ]
    }
  ],
  "language": "python",
  "timeout": 8,
  "code": "import os\ntry:\n    text = os.environ.get('TEXT') or os.environ.get('INPUT') or os.environ.get('MESSAGE') or os.environ.get('ARGS') or ''\n    mode = (os.environ.get('MODE') or 'chars').strip().lower()\n    if mode == 'words':\n        result = ' '.join(reversed(text.split(' ')))\n    elif mode == 'lines':\n        result = '\\n'.join(reversed(text.splitlines()))\n    else:\n        result = text[::-1]\n    print(result)\nexcept Exception as e:\n    print('error: ' + str(e))\n"
}
