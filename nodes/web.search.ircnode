{
  "typeId": "web.search",
  "title": "Web Search",
  "subtitle": "ai tool",
  "icon": "🔎",
  "category": "Ai",
  "description": "AI tool: searches the web (DuckDuckGo, no API key) and returns the top 3 results. Wire 'tool' into an Ask AI node's tools; the model calls it with a query.",
  "author": "ircuitry",
  "tags": [
    "ai",
    "tool",
    "web",
    "search"
  ],
  "inputs": [
    {
      "name": "query",
      "kind": "Text"
    }
  ],
  "outputs": [
    {
      "name": "tool",
      "kind": "Tool"
    },
    {
      "name": "results",
      "kind": "Text"
    }
  ],
  "params": [],
  "language": "python",
  "timeout": 15,
  "code": "import os, json, urllib.parse, urllib.request\n\nq = (os.environ.get('QUERY') or os.environ.get('ARGS') or '').strip()\nif not q:\n    print('No query given.'); raise SystemExit\n\nurl = 'https://api.duckduckgo.com/?' + urllib.parse.urlencode(\n    {'q': q, 'format': 'json', 'no_html': 1, 'skip_disambig': 1})\ntry:\n    req = urllib.request.Request(url, headers={'User-Agent': 'ircuitry-bot'})\n    data = json.load(urllib.request.urlopen(req, timeout=10))\nexcept Exception as e:\n    print('Search error: ' + str(e)); raise SystemExit\n\nresults = []\ndef walk(topics):\n    for t in topics:\n        if len(results) >= 3: return\n        if 'Topics' in t: walk(t['Topics'])\n        elif t.get('Text'): results.append((t['Text'], t.get('FirstURL', '')))\nwalk(data.get('RelatedTopics', []))\nif not results and data.get('AbstractText'):\n    results.append((data['AbstractText'], data.get('AbstractURL', '')))\n\nif not results:\n    print('No results for: ' + q)\nelse:\n    print('\\n'.join(f\"{i+1}. {t} ({u})\" if u else f\"{i+1}. {t}\"\n                    for i, (t, u) in enumerate(results)))\n"
}
