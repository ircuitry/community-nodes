{
  "typeId": "enc.hex",
  "title": "Hex Encode/Decode",
  "subtitle": "community",
  "icon": "🔣",
  "category": "Data",
  "description": "Converts text to or from its hexadecimal byte representation.",
  "inputs": [
    {
      "name": "",
      "kind": "Exec"
    },
    {
      "name": "text",
      "kind": "Text"
    }
  ],
  "outputs": [
    {
      "name": "then",
      "kind": "Exec"
    },
    {
      "name": "result",
      "kind": "Text"
    }
  ],
  "params": [
    {
      "key": "mode",
      "label": "Mode",
      "type": "Choice",
      "default": "encode",
      "choices": [
        "encode",
        "decode"
      ]
    }
  ],
  "language": "python",
  "timeout": 8,
  "code": "import os\ntext=(os.environ.get('TEXT') or os.environ.get('INPUT') or os.environ.get('MESSAGE') or os.environ.get('ARGS') or '')\nmode=(os.environ.get('MODE') or 'encode').strip().lower()\ntry:\n    if mode=='decode':\n        h=''.join(text.split()).strip()\n        print(bytes.fromhex(h).decode('utf-8'))\n    else:\n        print(text.encode('utf-8').hex())\nexcept Exception as e:\n    print('error: '+str(e))\n"
}
