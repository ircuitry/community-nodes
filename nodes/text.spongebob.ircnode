  "code": "import os\ns=(os.environ.get('TEXT') or os.environ.get('INPUT') or os.environ.get('MESSAGE') or os.environ.get('ARGS') or '')\ntry:\n    out=[]\n    upper=False\n    for ch in s:\n        if ch.isalpha():\n            out.append(ch.upper() if upper else ch.lower())\n            upper=not upper\n        else:\n            out.append(ch)\n    print(''.join(out))\nexcept Exception as e:\n    print(s)\n"
