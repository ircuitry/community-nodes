{
  "typeId": "text.zwsp",
  "title": "Invisible Ink (ZWSP)",
  "subtitle": "community",
  "icon": "👻",
  "category": "Data",
  "description": "Hides a secret message inside zero-width characters appended to cover text.",
  "inputs": [
    {
      "name": "",
      "kind": "Exec"
    },
    {
      "name": "text",
      "kind": "Text"
    },
    {
      "name": "secret",
      "kind": "Text"
    }
  ],
  "outputs": [
    {
      "name": "then",
      "kind": "Exec"
    },
    {
      "name": "result",
      "kind": "Text"
    }
  ],
  "params": [],
  "language": "python",
  "timeout": 8,
  "code": "import os\ntry:\n    cover = os.environ.get('TEXT') or os.environ.get('INPUT') or os.environ.get('MESSAGE') or ''\n    secret = os.environ.get('SECRET') or os.environ.get('ARGS') or ''\n    data = secret.encode('utf-8')\n    bits = ''.join(format(b, '08b') for b in data)\n    hidden = ''.join('\\u200b' if c == '0' else '\\u200c' for c in bits)\n    print(cover + hidden)\nexcept Exception as e:\n    print('error: ' + str(e))\n"
}
