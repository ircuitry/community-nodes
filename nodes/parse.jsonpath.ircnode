{
  "typeId": "parse.jsonpath",
  "title": "JSON Field Picker",
  "subtitle": "community",
  "icon": "🗂️",
  "category": "Data",
  "description": "Extracts a value from JSON using a simple dotted path.",
  "inputs": [
    {
      "name": "",
      "kind": "Exec"
    },
    {
      "name": "json",
      "kind": "Text"
    },
    {
      "name": "path",
      "kind": "Text"
    }
  ],
  "outputs": [
    {
      "name": "then",
      "kind": "Exec"
    },
    {
      "name": "result",
      "kind": "Text"
    }
  ],
  "params": [],
  "language": "python",
  "timeout": 8,
  "code": "import os, json\n\nraw = os.environ.get('JSON') or os.environ.get('INPUT') or os.environ.get('MESSAGE') or ''\npath = (os.environ.get('PATH_') or os.environ.get('PATH') or os.environ.get('ARGS') or '').strip()\n\ntry:\n    data = json.loads(raw)\nexcept Exception as e:\n    print('invalid JSON: ' + str(e))\n    raise SystemExit\n\ncur = data\nif path:\n    for part in path.split('.'):\n        if part == '':\n            continue\n        try:\n            if isinstance(cur, list):\n                cur = cur[int(part)]\n            elif isinstance(cur, dict):\n                if part in cur:\n                    cur = cur[part]\n                else:\n                    print('missing key: ' + part)\n                    raise SystemExit\n            else:\n                print('cannot descend into ' + type(cur).__name__ + ' at: ' + part)\n                raise SystemExit\n        except (ValueError, IndexError, KeyError, TypeError):\n            print('cannot resolve path segment: ' + part)\n            raise SystemExit\n\nif isinstance(cur, str):\n    print(cur)\nelse:\n    print(json.dumps(cur, ensure_ascii=False))\n"
}
