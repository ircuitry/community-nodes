{
  "typeId": "parse.csvfield",
  "title": "CSV Field",
  "subtitle": "community",
  "icon": "📊",
  "category": "Data",
  "description": "Extracts a column value from a CSV row by index or header.",
  "inputs": [
    {
      "name": "",
      "kind": "Exec"
    },
    {
      "name": "row",
      "kind": "Text"
    },
    {
      "name": "field",
      "kind": "Text"
    }
  ],
  "outputs": [
    {
      "name": "then",
      "kind": "Exec"
    },
    {
      "name": "result",
      "kind": "Text"
    }
  ],
  "params": [
    {
      "key": "delimiter",
      "label": "Delimiter",
      "type": "Text",
      "default": ","
    }
  ],
  "language": "python",
  "timeout": 8,
  "code": "import os, csv, io\nrow = (os.environ.get('ROW') or os.environ.get('INPUT') or os.environ.get('MESSAGE') or '').strip()\nfield = (os.environ.get('FIELD') or '0').strip()\ndelim = (os.environ.get('DELIMITER') or ',')\nif delim == '':\n    delim = ','\ntry:\n    cells = next(csv.reader(io.StringIO(row), delimiter=delim))\nexcept Exception:\n    cells = row.split(delim)\ntry:\n    if field.lstrip('+-').isdigit():\n        idx = int(field)\n        print(cells[idx])\n    else:\n        header = next(csv.reader(io.StringIO(row), delimiter=delim))\n        idx = header.index(field)\n        print(cells[idx])\nexcept (IndexError, ValueError):\n    print('')\nexcept Exception as e:\n    print('error: ' + str(e))\n"
}
