{
  "typeId": "parse.urls",
  "title": "Extract URLs",
  "subtitle": "community",
  "icon": "🔗",
  "category": "Filter",
  "description": "Finds all http/https URLs in text.",
  "inputs": [
    {
      "name": "",
      "kind": "Exec"
    },
    {
      "name": "text",
      "kind": "Text"
    }
  ],
  "outputs": [
    {
      "name": "then",
      "kind": "Exec"
    },
    {
      "name": "result",
      "kind": "Text"
    },
    {
      "name": "count",
      "kind": "Number"
    }
  ],
  "params": [],
  "language": "python",
  "timeout": 8,
  "code": "import os, re, json\ntry:\n    text = os.environ.get('TEXT') or os.environ.get('INPUT') or os.environ.get('MESSAGE') or ''\n    found = re.findall(r'https?://[^\\s<>\"\\')]+', text)\n    seen = set()\n    urls = []\n    for u in found:\n        if u not in seen:\n            seen.add(u)\n            urls.append(u)\n    print(json.dumps({'result': '\\n'.join(urls), 'count': len(urls)}))\nexcept Exception as e:\n    print(json.dumps({'result': '', 'count': 0}))\n"
}
