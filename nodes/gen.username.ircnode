  "language": "python",
  "timeout": 6,
  "code": "import os, random\ntry:\n    adjectives = ['brave','calm','clever','cosmic','crimson','daring','electric','fuzzy','golden','happy','icy','jolly','lucky','mighty','neon','quiet','rapid','silent','sly','swift','velvet','witty','zesty','noble','wild']\n    nouns = ['otter','falcon','badger','comet','ember','glacier','hawk','jaguar','koala','lynx','meteor','nebula','orca','panther','quokka','raven','sparrow','tiger','viper','walrus','yak','zebra','phoenix','dragon','wolf']\n    style = (os.environ.get('STYLE') or 'plain').strip().lower()\n    adj = random.choice(adjectives)\n    noun = random.choice(nouns)\n    num = random.randint(0, 99)\n    if style == 'snake':\n        name = f'{adj}_{noun}_{num}'\n    elif style == 'camel':\n        name = f'{adj}{noun.capitalize()}{num}'\n    else:\n        name = f'{adj}{noun}{num}'\n    print(name)\nexcept Exception as e:\n    print(f'user{random.randint(1000, 9999)}')\n"
}
