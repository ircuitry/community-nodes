{
  "typeId": "text.acronym",
  "title": "Acronym Maker",
  "subtitle": "community",
  "icon": "🆎",
  "category": "Data",
  "description": "Builds an acronym from the first letter of each word.",
  "inputs": [
    {
      "name": "",
      "kind": "Exec"
    },
    {
      "name": "text",
      "kind": "Text"
    }
  ],
  "outputs": [
    {
      "name": "then",
      "kind": "Exec"
    },
    {
      "name": "result",
      "kind": "Text"
    }
  ],
  "params": [],
  "language": "python",
  "timeout": 8,
  "code": "import os, re\ntext = (os.environ.get('TEXT') or os.environ.get('INPUT') or os.environ.get('MESSAGE') or os.environ.get('ARGS') or '').strip()\ntry:\n    letters = []\n    for word in text.split():\n        for ch in word:\n            if ch.isalpha():\n                letters.append(ch.upper())\n                break\n    acronym = ''.join(letters)\n    print(acronym if acronym else 'give some words to acronymize')\nexcept Exception as e:\n    print('error: ' + str(e))\n"
}
