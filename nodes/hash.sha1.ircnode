{
  "typeId": "hash.sha1",
  "title": "SHA1 Hash",
  "subtitle": "community",
  "icon": "🔑",
  "category": "Data",
  "description": "Computes the SHA1 hash of input text.",
  "inputs": [
    {
      "name": "",
      "kind": "Exec"
    },
    {
      "name": "text",
      "kind": "Text"
    }
  ],
  "outputs": [
    {
      "name": "then",
      "kind": "Exec"
    },
    {
      "name": "result",
      "kind": "Text"
    }
  ],
  "params": [],
  "language": "python",
  "timeout": 8,
  "code": "import os, hashlib\ntry:\n    text = os.environ.get('TEXT')\n    if text is None:\n        text = os.environ.get('INPUT') or os.environ.get('MESSAGE') or os.environ.get('ARGS') or ''\n    print(hashlib.sha1(text.encode('utf-8')).hexdigest())\nexcept Exception as e:\n    print(f'error: {e}')\n"
}
