{
  "typeId": "text.mdstrip",
  "title": "Strip Markdown",
  "subtitle": "community",
  "icon": "📝",
  "category": "Data",
  "description": "Removes common markdown formatting to produce plain text.",
  "inputs": [
    {
      "name": "",
      "kind": "Exec"
    },
    {
      "name": "text",
      "kind": "Text"
    }
  ],
  "outputs": [
    {
      "name": "then",
      "kind": "Exec"
    },
    {
      "name": "result",
      "kind": "Text"
    }
  ],
  "params": [],
  "language": "python",
  "timeout": 8,
  "code": "import os, re\ntry:\n    t = os.environ.get('TEXT') or os.environ.get('INPUT') or os.environ.get('MESSAGE') or os.environ.get('ARGS') or ''\n    # links [text](url) -> text ; images ![alt](url) -> alt\n    t = re.sub(r'!?\\[([^\\]]*)\\]\\([^)]*\\)', r'\\1', t)\n    # headers at line start: ###, ## ...\n    t = re.sub(r'(?m)^\\s{0,3}#{1,6}\\s*', '', t)\n    # blockquotes at line start\n    t = re.sub(r'(?m)^\\s{0,3}>\\s?', '', t)\n    # bold/italic: ** __ * _\n    t = re.sub(r'\\*\\*([^*]+)\\*\\*', r'\\1', t)\n    t = re.sub(r'__([^_]+)__', r'\\1', t)\n    t = re.sub(r'\\*([^*]+)\\*', r'\\1', t)\n    t = re.sub(r'_([^_]+)_', r'\\1', t)\n    # inline code `code`\n    t = re.sub(r'`([^`]*)`', r'\\1', t)\n    print(t.strip())\nexcept Exception as e:\n    print((os.environ.get('TEXT') or os.environ.get('INPUT') or ''))\n"
}
