{
  "typeId": "text.case",
  "title": "Change Case",
  "subtitle": "community",
  "icon": "🔠",
  "category": "Data",
  "description": "Converts text between upper, lower, title, sentence, and swap case.",
  "inputs": [
    {
      "name": "",
      "kind": "Exec"
    },
    {
      "name": "text",
      "kind": "Text"
    }
  ],
  "outputs": [
    {
      "name": "then",
      "kind": "Exec"
    },
    {
      "name": "result",
      "kind": "Text"
    }
  ],
  "params": [
    {
      "key": "mode",
      "label": "Mode",
      "type": "Choice",
      "default": "upper",
      "choices": [
        "upper",
        "lower",
        "title",
        "sentence",
        "swap"
      ]
    }
  ],
  "language": "python",
  "timeout": 8,
  "code": "import os, re\ntry:\n    text = os.environ.get('TEXT') or os.environ.get('INPUT') or os.environ.get('MESSAGE') or os.environ.get('ARGS') or ''\n    mode = (os.environ.get('MODE') or 'upper').strip().lower()\n    if mode == 'upper':\n        out = text.upper()\n    elif mode == 'lower':\n        out = text.lower()\n    elif mode == 'title':\n        out = text.title()\n    elif mode == 'swap':\n        out = text.swapcase()\n    elif mode == 'sentence':\n        def cap(m):\n            return m.group(0).upper()\n        out = re.sub(r'(^\\s*[a-z])|([.!?]\\s+[a-z])', cap, text.lower())\n    else:\n        out = text\n    print(out)\nexcept Exception as e:\n    print('error: ' + str(e))\n"
}
