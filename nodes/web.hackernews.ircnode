{
  "typeId": "web.hackernews",
  "title": "Hacker News",
  "subtitle": "composite",
  "icon": "y-combinator-logo",
  "category": "Action",
  "description": "Fetches the current Hacker News front page and outputs the top story's title, link, and the raw JSON. No input needed.",
  "author": "ircuitry",
  "tags": ["hackernews", "hn", "web", "news", "tech"],
  "inputs": [
    { "name": "", "kind": "Exec" }
  ],
  "outputs": [
    { "name": "then", "kind": "Exec" },
    { "name": "title", "kind": "Text" },
    { "name": "link", "kind": "Text" },
    { "name": "json", "kind": "Text" }
  ],
  "params": [],
  "subgraph": {
    "format": "ircuitry.workflow.v1",
    "name": "Hacker News",
    "nodes": [
      { "id": "in", "type": "flow.in", "x": -460, "y": -140, "params": {} },
      { "id": "h", "type": "net.http", "x": -200, "y": -140, "params": { "method": "GET", "url": "https://hn.algolia.com/api/v1/search?tags=front_page", "send": "body", "field": "file", "file": "", "headers": "", "body": "", "timeout": "15" } },
      { "id": "jt", "type": "data.json", "x": 100, "y": -60, "params": { "path": "hits.0.title" } },
      { "id": "jl", "type": "data.json", "x": 100, "y": 60, "params": { "path": "hits.0.url" } },
      { "id": "rt", "type": "flow.return", "x": 360, "y": -140, "params": { "name": "title" } },
      { "id": "rl", "type": "flow.return", "x": 360, "y": -20, "params": { "name": "link" } },
      { "id": "rj", "type": "flow.return", "x": 360, "y": 100, "params": { "name": "json" } }
    ],
    "connections": [
      { "from": "in", "fromPin": 0, "to": "h", "toPin": 0 },
      { "from": "h", "fromPin": 1, "to": "jt", "toPin": 0 },
      { "from": "h", "fromPin": 1, "to": "jl", "toPin": 0 },
      { "from": "h", "fromPin": 1, "to": "rj", "toPin": 1 },
      { "from": "jt", "fromPin": 0, "to": "rt", "toPin": 1 },
      { "from": "jl", "fromPin": 0, "to": "rl", "toPin": 1 },
      { "from": "h", "fromPin": 0, "to": "rt", "toPin": 0 },
      { "from": "rt", "fromPin": 0, "to": "rl", "toPin": 0 },
      { "from": "rl", "fromPin": 0, "to": "rj", "toPin": 0 }
    ]
  }
}
