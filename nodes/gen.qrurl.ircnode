{
  "typeId": "gen.qrurl",
  "title": "QR Code URL",
  "subtitle": "community",
  "icon": "📱",
  "category": "Data",
  "description": "Builds a QR code image URL for any text or link.",
  "inputs": [
    {
      "name": "",
      "kind": "Exec"
    },
    {
      "name": "text",
      "kind": "Text"
    }
  ],
  "outputs": [
    {
      "name": "then",
      "kind": "Exec"
    },
    {
      "name": "url",
      "kind": "Text"
    }
  ],
  "params": [
    {
      "key": "size",
      "label": "Size",
      "type": "Int",
      "default": 200
    }
  ],
  "language": "python",
  "timeout": 8,
  "code": "import os\nfrom urllib.parse import quote\ntry:\n    text=(os.environ.get('TEXT') or os.environ.get('INPUT') or os.environ.get('ARGS') or os.environ.get('MESSAGE') or '').strip()\n    try:\n        size=int((os.environ.get('SIZE') or '200').strip())\n    except Exception:\n        size=200\n    if size<10:\n        size=10\n    if size>1000:\n        size=1000\n    if not text:\n        print('give some text or a link to encode')\n    else:\n        encoded=quote(text, safe='')\n        print(f'https://api.qrserver.com/v1/create-qr-code/?size={size}x{size}&data={encoded}')\nexcept Exception as e:\n    print(f'error: {e}')\n"
}
