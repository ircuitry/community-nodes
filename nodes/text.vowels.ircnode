{
  "typeId": "text.vowels",
  "title": "Disemvowel",
  "subtitle": "community",
  "icon": "🅰️",
  "category": "Data",
  "description": "Removes or counts the vowels in a piece of text.",
  "inputs": [
    {
      "name": "",
      "kind": "Exec"
    },
    {
      "name": "text",
      "kind": "Text"
    }
  ],
  "outputs": [
    {
      "name": "then",
      "kind": "Exec"
    },
    {
      "name": "result",
      "kind": "Text"
    }
  ],
  "params": [
    {
      "key": "mode",
      "label": "Mode",
      "type": "Choice",
      "default": "remove",
      "choices": [
        "remove",
        "count"
      ]
    }
  ],
  "language": "python",
  "timeout": 8,
  "code": "import os\ntry:\n    text = os.environ.get('TEXT') or os.environ.get('INPUT') or os.environ.get('MESSAGE') or os.environ.get('ARGS') or ''\n    mode = (os.environ.get('MODE') or 'remove').strip().lower()\n    vowels = set('aeiouAEIOU')\n    if mode == 'count':\n        print(sum(1 for ch in text if ch in vowels))\n    else:\n        print(''.join(ch for ch in text if ch not in vowels))\nexcept Exception as e:\n    print('error: ' + str(e))\n"
}
