{
  "typeId": "text.truncate",
  "title": "Truncate Text",
  "subtitle": "community",
  "icon": "✂️",
  "category": "Data",
  "description": "Shortens text to a max length and appends an ellipsis.",
  "inputs": [
    {
      "name": "",
      "kind": "Exec"
    },
    {
      "name": "text",
      "kind": "Text"
    }
  ],
  "outputs": [
    {
      "name": "then",
      "kind": "Exec"
    },
    {
      "name": "result",
      "kind": "Text"
    }
  ],
  "params": [
    {
      "key": "length",
      "label": "Max Length",
      "type": "Int",
      "default": 80
    },
    {
      "key": "suffix",
      "label": "Suffix",
      "type": "Text",
      "default": "..."
    }
  ],
  "language": "python",
  "timeout": 8,
  "code": "import os\ntry:\n    text = os.environ.get('TEXT') or os.environ.get('INPUT') or os.environ.get('MESSAGE') or ''\n    try:\n        length = int(os.environ.get('LENGTH') or '80')\n    except Exception:\n        length = 80\n    suffix = os.environ.get('SUFFIX')\n    if suffix is None:\n        suffix = '...'\n    if length < 0:\n        length = 0\n    if len(text) > length:\n        result = text[:length].rstrip() + suffix\n    else:\n        result = text\n    print(result)\nexcept Exception as e:\n    print('error: ' + str(e))\n"
}
