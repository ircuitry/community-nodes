{
  "typeId": "parse.emails",
  "title": "Extract Emails",
  "subtitle": "community",
  "icon": "📧",
  "category": "Filter",
  "description": "Finds all email addresses in a block of text.",
  "inputs": [
    {
      "name": "",
      "kind": "Exec"
    },
    {
      "name": "text",
      "kind": "Text"
    }
  ],
  "outputs": [
    {
      "name": "then",
      "kind": "Exec"
    },
    {
      "name": "result",
      "kind": "Text"
    },
    {
      "name": "count",
      "kind": "Number"
    }
  ],
  "params": [],
  "language": "python",
  "timeout": 8,
  "code": "import os, re, json\ntry:\n    text = os.environ.get('TEXT') or os.environ.get('INPUT') or os.environ.get('MESSAGE') or os.environ.get('ARGS') or ''\n    pattern = r'[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}'\n    found = re.findall(pattern, text)\n    seen = set()\n    emails = []\n    for e in found:\n        k = e.lower()\n        if k not in seen:\n            seen.add(k)\n            emails.append(e)\n    print(json.dumps({'result': '\\n'.join(emails), 'count': len(emails)}))\nexcept Exception as ex:\n    print(json.dumps({'result': '', 'count': 0, 'error': str(ex)}))\n"
}
