{
  "typeId": "gen.dice",
  "title": "Dice Notation Roller",
  "subtitle": "community",
  "icon": "🎲",
  "category": "Action",
  "description": "Rolls dice using standard NdM+K notation and shows the breakdown.",
  "inputs": [
    {
      "name": "",
      "kind": "Exec"
    },
    {
      "name": "notation",
      "kind": "Text"
    }
  ],
  "outputs": [
    {
      "name": "then",
      "kind": "Exec"
    },
    {
      "name": "total",
      "kind": "Number"
    },
    {
      "name": "rolls",
      "kind": "Text"
    }
  ],
  "params": [],
  "language": "python",
  "timeout": 8,
  "code": "import os, re, json, random\nspec=(os.environ.get('NOTATION') or os.environ.get('INPUT') or os.environ.get('ARGS') or '1d20').strip().lower()\ntry:\n    m=re.fullmatch(r'(\\d*)d(\\d+)([+-]\\d+)?', spec.replace(' ',''))\n    if not m:\n        raise ValueError('use NdM+K notation, e.g. 1d20, 3d6+2, 2d8-1')\n    count=int(m.group(1) or '1')\n    sides=int(m.group(2))\n    mod=int(m.group(3) or '0')\n    if count < 1 or count > 1000 or sides < 1:\n        raise ValueError('count must be 1-1000 and sides >= 1')\n    rolls=[random.randint(1, sides) for _ in range(count)]\n    total=sum(rolls)+mod\n    print(json.dumps({'total': total, 'rolls': rolls}))\nexcept Exception as e:\n    print(json.dumps({'total': 0, 'rolls': str(e)}))\n"
}
